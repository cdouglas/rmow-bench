{
  "label": "sim-validate-s3x",
  "store": {
    "type": "mem",
    "root": "mem://bench",
    "latency": {
      "profile": "s3x",
      "getMs": 2.5,
      "getSigma": 0.57,
      "putMs": 6.5,
      "putSigma": 0.24,
      "appendMs": 13.0,
      "appendSigma": 0.25,
      "partMs": 0.0,
      "readMsPerMib": 10.0,
      "writeMsPerMib": 10.0
    }
  },
  "warmup": {
    "batches": 5,
    "initialRows": 100000
  },
  "workload": {
    "seed": 1,
    "initialRows": 200000,
    "batches": 20,
    "opsPerBatch": 2000,
    "insertFrac": 0.7,
    "updateFrac": 0.25,
    "deleteFrac": 0.05,
    "keyDist": "RECENCY_EXP",
    "recencyMeanBatches": 2.0
  },
  "layout": {
    "codec": "zstd",
    "rowGroupBytes": 1048576,
    "targetFileBytes": 8388608,
    "tailSealBytes": 1048576,
    "locate": "scan",
    "compactEvery": 10
  },
  "arms": [
    "mor-v3",
    "tailcow-c",
    "rmow-b",
    "rmow-c",
    "rmow-c-split"
  ],
  "reads": {
    "every": 5,
    "recentFraction": 0.01,
    "travelBack": 10,
    "readers": [
      {
        "name": "one-footer",
        "footerCache": true,
        "footerPrefetchBytes": 65536
      },
      {
        "name": "cached",
        "footerCache": true,
        "deleteCache": true,
        "footerPrefetchBytes": 65536
      },
      {
        "name": "cached-p8",
        "footerCache": true,
        "deleteCache": true,
        "footerPrefetchBytes": 65536,
        "parallelism": 8
      },
      {
        "name": "stock"
      }
    ]
  },
  "verifyRows": true
}
