# Copy to deploy/deploy.env and edit. Sourced by deploy.sh. deploy.env is gitignored.

# Which cloud: aws (S3 Express) | azure (ADLS Gen2). Override per command:
#   CLOUD=azure ./deploy/deploy.sh up
CLOUD="aws"

# --- common ---
SSH_USER="ubuntu"
# Azure takes only RSA keys (ssh-keygen -t rsa -b 4096 -f ~/.ssh/rmow-bench-cloud); AWS imports the
# same public key as a key pair
SSH_PRIVATE_KEY="$HOME/.ssh/rmow-bench-cloud"
SSH_PUBLIC_KEY="$HOME/.ssh/rmow-bench-cloud.pub"
INGRESS_CIDR=""      # empty: this machine's public IP/32; or set it, e.g. 203.0.113.4/32
DISK_GB=64           # the VM's disk: the fork's build and Gradle's and Maven's caches

# --- the builds (docs/S3X_RUNBOOK.md, Steps) ---
# The fork at the twins' build (public, cloned on the VM); its version comes from the release tag,
# fetched from Apache's repository
FORK_REPO="https://github.com/cdouglas/iceberg.git"
FORK_COMMIT="af875ccfd1845ecace46d5c48a594561cd54213d"
FORK_BASE_TAG="apache-iceberg-1.12.0"
# rmow-bench: the build the runs use, whose code must be their twins' (the calibration's: 9a69028,
# where C1-C4 were registered; the sweeps': the commit havoc ran); the spike from main. Both must
# be on main, which ship bundles. CALIBRATION_COMMIT, from before the bench step, still works
BENCH_COMMIT="9a69028"
SPIKE_COMMIT="main"

# --- the steps ---
SPIKE_REPS=20
# The bench step runs each configuration (configs/<name>.json at BENCH_COMMIT) BENCH_REPS times on
# the cloud's store. One with a local store, a run made on the laptop or havoc, runs under its label
# suffixed -s3x or -azure, so that run is its twin; one with a cloud store (the calibration's) keeps
# its label. For the sweeps, e.g.: AWS_CONFIGS="sweep-base sweep-p30", BENCH_HEAP="16g",
# BENCH_FLAGS="--log-requests --log-held", BENCH_REPS=1, and an instance with 32 GiB (c7a.4xlarge)
AWS_CONFIGS="s3x-calibration"
AZURE_CONFIGS="azure-calibration"
BENCH_REPS=3                 # for the spread of measured latency (CALIBRATION_REPS still works)
BENCH_HEAP="8g"              # each run's -Xmx
BENCH_FLAGS="--log-requests" # bin/run.sh's flags
# One VM per configuration (true), named after it, all at once, each running its own spike and run;
# or one VM (false) running the configurations in turn. A fleet needs the cloud's vCPU quota for all
# of them (Azure's westus allowed 10 vCPUs, one D8as_v6, on 2026-10-30), and its spikes need
# SPIKE_COMMIT from 2026-10-30 on (--label). Run the test step on one VM: VM=<name> deploy.sh run test
FLEET=false
SAS_HOURS=8          # the life of the SAS the Azure contract suite takes
WAIT_UNREACHABLE_MIN=60 # how long `wait` waits on a VM it cannot reach before failing (minutes)

# --- AWS (CLOUD=aws) ---
AWS_REGION="us-west-2"         # us-west, as catalog-bench's runs
AWS_AZ_ID="usw2-az3"            # a zone with S3 Express and the instance type; catalog-bench's bucket's
AWS_INSTANCE_TYPE="c7a.2xlarge" # AMD Zen 4, as the twins' laptop; 8 vCPUs, 16 GiB (c7a.4xlarge: 32 GiB)
# An existing directory bucket and instance profile, for an operator who may not create IAM roles
# (empty: infra-up makes both). These are catalog-bench's, as casuser runs: its bucket, whose
# profile's role may open sessions on it. The runs write under the bucket's rmow-bench/ prefix,
# which teardown deletes; the bucket stays.
AWS_BUCKET="lst-pbafvfgrapl--usw2-az3--x-s3"
AWS_INSTANCE_PROFILE="ycsb-ec2-instance-profile"
AWS_CREATE_ENDPOINT=false       # false where the default VPC has the S3 Express gateway endpoint (us-west-2's does)

# --- Azure (CLOUD=azure) ---
AZURE_LOCATION="westus"          # catalog-bench's "West US"
AZURE_RESOURCE_GROUP="rmow-bench"
AZURE_VM_SIZE="Standard_D8as_v6" # AMD Zen 4, as the twins' laptop and the AWS c7a; 8 vCPUs, 32 GiB
