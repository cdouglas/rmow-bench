    {"config": "configs/mor-row-ingest-rows.json", "heap": "12g", "store_gib": 45},
    {"config": "configs/mor-row-s0.json", "heap": "12g", "store_gib": 32},
    {"config": "configs/mor-row-base.json", "heap": "12g", "store_gib": 30},
    {"config": "configs/mor-row-late99-1.json", "heap": "12g", "store_gib": 30},
    {"config": "configs/mor-row-late99-20.json", "heap": "12g", "store_gib": 30},
    {"config": "configs/mor-row-s2.json", "heap": "12g", "store_gib": 25},
    {"config": "configs/mor-row-ingest.json", "heap": "12g", "store_gib": 22},
    {"config": "configs/mor-row-p10.json", "heap": "12g", "store_gib": 20},
